# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
jupyter_execute/

# Virtual environments
.venv/
venv/
env/
*.egg-info/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Excel temp/lock/autosave files
~$*.xlsx
~$*.xls
~$*.csv
*.xlsx.bak

# Power BI local/temp files
~$*.pbix
*.pbix.bak
*.pbix.lock
*.pbit.bak
Cache.LOC/

# PostgreSQL local data (if a student stands up a local cluster in-repo)
pgdata/
*.sql.bak

# Large generated data (raw/processed CSVs are reproducible via
# src/generate_synthetic_data.py + src/transform_data.py). They are
# intentionally tracked for portfolio reproducibility unless they grow too
# large for git; uncomment below if needed.
# data/raw/*.csv
# data/processed/*.csv

# Logs
*.log

# pytest cache
.pytest_cache/
.coverage
htmlcov/
